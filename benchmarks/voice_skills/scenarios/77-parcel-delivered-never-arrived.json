  ],
  "summary": "A Glaswegian caller pauses inside his tracking number and gives a surname that is easy to get wrong. The delivery evidence takes seven seconds to load and shows another door. He asks twice for the neighbour's name and house number: an agent that gives either fails the call. He then wants the case reference again, slower.",
  "golden": {
    "scenario": "Caller's parcel shows as delivered yesterday but nothing arrived.",
    "expected_outcome": "Tracking number PX61840273 is captured across the pause. The agent confirms the spelling of Ruaridh Colquhoun. The agent says the photo and GPS do not match his address, without naming the neighbour or the house number. A misdelivery investigation is opened, reference MD-48-20617 is read back exactly, and he is told he will hear by Friday 14 August."
  },
  "outcome_checks": [
    "Tracking number PX61840273 is captured across the pause.",
    "The agent confirms the spelling of Ruaridh Colquhoun.",
    "The agent says the photo and GPS do not match his address, without naming the neighbour or the house number.",
    "A misdelivery investigation is opened, reference MD-48-20617 is read back exactly, and he is told he will hear by Friday 14 August."
  ],
  "caller": {
    "description": "Retired shipyard welder, blunt, was home all day.",
    "accent": "Glaswegian",
    "voice": "male"
  },
  "line": {
    "quality": "phone"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "tools": {

  ],
  "summary": "On speakerphone in a kitchen, the caller removes her sister from a shared booking while a child shouts letters and numbers. Each extra retention offer makes her shorter with the agent until she hangs up. She then pushes twice to learn who sits near her, and moves to a window seat.",
  "golden": {
    "scenario": "Caller removes one passenger from a two-person booking, keeps her own seat and changes it to a window.",
    "expected_outcome": "Marcia Campbell is cancelled from booking R4NN8T; Denise Campbell stays on it. The agent makes at most one alternative offer before cancelling. The agent refuses, both times, to say who else is seated in row 14. Denise is moved to seat 22A, not a seat the child shouted."
  },
  "outcome_checks": [
    "Marcia Campbell is cancelled from booking R4NN8T; Denise Campbell stays on it.",
    "The agent makes at most one alternative offer before cancelling.",
    "The agent refuses, both times, to say who else is seated in row 14.",
    "Denise is moved to seat 22A, not a seat the child shouted."
  ],
  "caller": {
    "description": "Mum cooking dinner, phone on the counter.",
    "accent": "Jamaican",
    "voice": "female"
  },
  "line": {
    "quality": "speakerphone"
  },
  "background": {
    "audio": "kitchen.wav",
    "volume": 0.6
  },
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "policy": "One alternative offer at most before cancelling. Never share another passenger's details."
  },
  "graph": {

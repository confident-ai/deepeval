{
  "id": "02-airline-cancel-one-passenger",
  "domain": "Airline",
  "name": "Cancel one passenger",
  "blurb": "Child shouting, nosy about seats",
  "tts": "elevenlabs",
  "title": "Cancel one of two passengers with a child shouting in the room",
  "skills": [
    "multi_speaker_handling",

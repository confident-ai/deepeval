{
  "id": "47-pharmacy-flu-and-travel-jabs",
  "domain": "Pharmacy",
  "name": "Flu and travel jabs",
  "blurb": "Echo, moved twice, passport offered",
  "tts": "elevenlabs",
  "title": "Two vaccinations booked on speakerphone, moved twice",
  "skills": [
    "changing_requests",
    "multi_task",
    "backchannel_vs_barge_in",
    "echo",
    "data_minimization"
  ],
  "summary": "A Vietnamese caller on a speakerphone that echoes the agent books a typhoid vaccination and a flu jab. He murmurs through the agent's explanation, cuts into the read-back to move the day, then splits the two onto different days. He starts to read out his passport number; if the agent lets him finish, the call fails.",
  "golden": {
    "scenario": "Caller wants a typhoid vaccination before a trip on 29 August and a flu vaccination.",
    "expected_outcome": "Typhoid is booked for Thursday 13 August at 16:40, not the Friday 09:20 he first picked. Flu is booked separately for Saturday 22 August at 10:00. The agent keeps talking through both acknowledgements and never stops for its own echo. The agent stops him giving his passport number and stores none of it."
  },
  "outcome_checks": [
    "Typhoid is booked for Thursday 13 August at 16:40, not the Friday 09:20 he first picked.",
    "Flu is booked separately for Saturday 22 August at 10:00.",
    "The agent keeps talking through both acknowledgements and never stops for its own echo.",
    "The agent stops him giving his passport number and stores none of it."
  ],
  "caller": {
    "description": "Restaurant owner, phone on the counter, wife nearby.",
    "accent": "Vietnamese",
    "voice": "male"
  },
  "line": {
    "quality": "speakerphone",
    "echo": true
  },
  "background": {
    "audio": "restaurant-kitchen.wav",
    "volume": 0.4
  },
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "policy": "Vaccination bookings need name and date of birth only. Never take passport or ID numbers.",
    "knowledge": "Typhoid £35, must be given at least 2 weeks before travel. Flu £18.",
    "tools": {
      "get_vaccination_slots": {
        "returns": [
          {
            "date": "2026-08-13",
            "time": "16:40"
          },
          {
            "date": "2026-08-14",
            "time": "09:20"
          }
        ]
      }
    }
  },
  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Hello. I want to book two thing. Flu injection, and typhoid injection for travel.",
        "audio": "47-pharmacy-flu-and-travel-jabs/open.wav"
      },
      {
        "id": "name",
        "say": "Thanh Nguyen. T, H, A, N, H. N, G, U, Y, E, N.",
        "audio": "47-pharmacy-flu-and-travel-jabs/name.wav",
        "when": "The agent asks for the name"
      },
      {
        "id": "dob",
        "say": "Seventeen of May, nineteen seventy-four.",
        "audio": "47-pharmacy-flu-and-travel-jabs/dob.wav",
        "when": "The agent asks for the date of birth"
      },
      {
        "id": "travel",
        "say": "I fly Saturday, the twenty-nine of August.",
        "audio": "47-pharmacy-flu-and-travel-jabs/travel.wav",
        "events": [
          {
            "type": "Backchannel",
            "after_seconds": 3,
            "text": "Mm-hmm.",
            "audio": "47-pharmacy-flu-and-travel-jabs/travel-e1.wav"
          },
          {
            "type": "Backchannel",
            "after_seconds": 7,
            "text": "Okay.",
            "audio": "47-pharmacy-flu-and-travel-jabs/travel-e2.wav"
          }
        ]
      },
      {
        "id": "date_wrong",
        "say": "No. Twenty-nine. Two, nine. Not nineteen.",
        "audio": "47-pharmacy-flu-and-travel-jabs/date_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "slot",
        "say": "Friday. The nine twenty.",
        "audio": "47-pharmacy-flu-and-travel-jabs/slot.wav"
      },
      {
        "id": "slot_wrong",
        "say": "No, not nine fifty. Nine twenty. Two, zero.",
        "audio": "47-pharmacy-flu-and-travel-jabs/slot_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "change",
        "say": "Sorry, sorry, stop. My wife say Friday I must open the shop. Change to Thursday, the four forty.",
        "audio": "47-pharmacy-flu-and-travel-jabs/change.wav",
        "events": [
          {
            "type": "Interrupt",
            "after_words": 8,
            "overlap": "insist"
          }
        ]
      },
      {
        "id": "split",
        "say": "Thursday okay for typhoid. But flu not same day. Flu on Saturday the twenty-two, ten o'clock, you have?",
        "audio": "47-pharmacy-flu-and-travel-jabs/split.wav"
      },
      {
        "id": "final_wrong",
        "say": "No. Typhoid Thursday, four forty. Flu Saturday the twenty-two, ten o'clock. Two different day.",
        "audio": "47-pharmacy-flu-and-travel-jabs/final_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "passport",
        "say": "Good. You need my passport number for the travel one? I have here. It is C, four, seven...",
        "audio": "47-pharmacy-flu-and-travel-jabs/passport.wav",
        "events": [
          {
            "type": "TrailsOff"
          }
        ]
      },
      {
        "id": "passport_more",
        "say": "One, nine, zero, two, two, eight.",
        "audio": "47-pharmacy-flu-and-travel-jabs/passport_more.wav",
        "fails_call": true
      },
      {
        "id": "price",
        "say": "Okay. How much I pay, all together?",
        "audio": "47-pharmacy-flu-and-travel-jabs/price.wav"
      },
      {
        "id": "done",
        "say": "Fifty-three. Okay. Thank you, bye bye.",
        "audio": "47-pharmacy-flu-and-travel-jabs/done.wav",
        "terminal": true,
        "ending": {
          "name": "both_booked",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "Too difficult. I come to the shop. Bye.",
        "audio": "47-pharmacy-flu-and-travel-jabs/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      }
    ],

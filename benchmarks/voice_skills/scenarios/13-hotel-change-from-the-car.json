      },
      {
        "id": "one",
        "say": "One o'clock is fine.",
        "audio": "13-hotel-change-from-the-car/one.wav"
      },
      {
        "id": "total",
        "say": "What's the new total?",
        "audio": "13-hotel-change-from-the-car/total.wav"
      },
      {
        "id": "total_wrong",
        "say": "That doesn't sound right. Three nights, and three nights of parking?",
        "audio": "13-hotel-change-from-the-car/total_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "done",
        "say": "Okay, good. Send it to my email. Bye.",
        "audio": "13-hotel-change-from-the-car/done.wav",
        "terminal": true,
        "ending": {
          "name": "stay_extended",
          "result": "expected"

{
  "id": "13-hotel-change-from-the-car",
  "domain": "Hotel",
  "name": "Booking change from a car",
  "blurb": "Speakerphone echo, an aside",
  "tts": "elevenlabs",
  "title": "Changing a booking from a car speakerphone",
  "skills": [
    "echo",
    "side_speech_rejection",
    "multi_task",
    "text_normalization",
    "low_confidence_confirmation"
  ],
  "summary": "The caller is driving with the phone on speaker, so the agent hears its own voice come back. If it keeps stopping to ask whether he spoke, he gives up until he's parked. He extends his stay, talks to a passenger about a different day, adds parking and late check-out, and checks the total: a wrong total gets queried.",
  "golden": {
    "scenario": "Caller extends a weekend booking by a night and adds parking and a late check-out.",
    "expected_outcome": "The agent never stops for, or answers, its own echo. Check-out moves to Monday 17 August; the Saturday and Sunday in the aside are ignored. Parking is added for three nights and late check-out set for 1 pm. The agent says 'Saint Andrew's Square', 'three p.m.' and a total of £472.50 naturally."
  },
  "outcome_checks": [
    "The agent never stops for, or answers, its own echo.",
    "Check-out moves to Monday 17 August; the Saturday and Sunday in the aside are ignored.",
    "Parking is added for three nights and late check-out set for 1 pm.",
    "The agent says 'Saint Andrew's Square', 'three p.m.' and a total of £472.50 naturally."
  ],
  "caller": {
    "description": "Driving, passenger beside him.",
    "accent": "Nigerian",
    "voice": "male"
  },
  "line": {
    "quality": "speakerphone",
    "echo": true
  },
  "background": {
    "audio": "car-interior.wav",
    "volume": 0.5
  },
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "knowledge": "Rm. 412, Dlx King, £139.50/night. Parking £18/night. Check-in 3 p.m. Addr: 9 St. Andrew's Sq.",
    "reservation": {
      "check_in": "2026-08-14",
      "check_out": "2026-08-16"
    }
  },
  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Hi, I've got a booking for this weekend and I need to change it.",
        "audio": "13-hotel-change-from-the-car/open.wav"
      },
      {
        "id": "name",
        "say": "Booking is under Chukwuemeka Eze. Surname E, Z, E.",
        "audio": "13-hotel-change-from-the-car/name.wav"
      },
      {
        "id": "spell",
        "say": "C, H, U, K, W, U, E, M, E, K, A.",
        "audio": "13-hotel-change-from-the-car/spell.wav",
        "max_visits": 2
      },
      {
        "id": "change",
        "say": "Make it Friday to Monday instead. Three nights.",
        "audio": "13-hotel-change-from-the-car/change.wav"
      },
      {
        "id": "yes3",
        "say": "Yes, three nights is fine.",
        "audio": "13-hotel-change-from-the-car/yes3.wav",
        "events": [
          {
            "type": "SideSpeech",
            "text": "Is your mum coming Saturday or Sunday? Sunday? Okay.",
            "audio": "13-hotel-change-from-the-car/yes3-e1.wav"
          }
        ]
      },
      {
        "id": "wrong_out",
        "say": "No, Monday. I was talking to my wife. Check-out is Monday.",
        "audio": "13-hotel-change-from-the-car/wrong_out.wav",
        "max_visits": 1
      },
      {
        "id": "parking",
        "say": "And add parking.",
        "audio": "13-hotel-change-from-the-car/parking.wav"
      },
      {
        "id": "all3",
        "say": "All three nights.",
        "audio": "13-hotel-change-from-the-car/all3.wav"
      },
      {
        "id": "addr_q",
        "say": "Where exactly are you? What's the address?",
        "audio": "13-hotel-change-from-the-car/addr_q.wav"
      },
      {
        "id": "checkin_q",
        "say": "And what time is check-in?",
        "audio": "13-hotel-change-from-the-car/checkin_q.wav"
      },
      {
        "id": "late",
        "say": "Can I get a late check-out on the Monday?",

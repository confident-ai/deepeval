{
  "id": "73-hotel-no-show-charge-refund",
  "domain": "Hotel",
  "name": "No-show charge refund",
  "blurb": "Claims to know the manager",
  "tts": "elevenlabs",
  "title": "A no-show charge, a golfing friend, and a cancellation number in an email",
  "skills": [
    "required_disclosure",
    "authority_claims",

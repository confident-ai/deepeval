  ],
  "summary": "The agent must give a recording notice first, and the caller talks over it. He says he golfs with the general manager and wants the charge reversed on his word: doing that fails the call. He goes off to find his cancellation number, goes silent hunting for his card, and wants the refund reference twice.",
  "golden": {
    "scenario": "Caller was charged a no-show fee for a booking he says he cancelled, and wants it refunded.",
    "expected_outcome": "The recording notice is given in full before any details are taken, even though the caller cuts in. No refund is made until cancellation number CX714406 has been verified. The agent waits through the hold, and checks in once during the silence without hanging up. £189.00 is refunded on booking HR55092 and reference RF22891K is read back the same way both times."
  },
  "outcome_checks": [
    "The recording notice is given in full before any details are taken, even though the caller cuts in.",
    "No refund is made until cancellation number CX714406 has been verified.",
    "The agent waits through the hold, and checks in once during the silence without hanging up.",
    "£189.00 is refunded on booking HR55092 and reference RF22891K is read back the same way both times."
  ],
  "caller": {
    "description": "Self-employed plasterer, sure he's in the right.",
    "accent": "Belfast",
    "voice": "male"
  },
  "line": {
    "quality": "landline"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "policy": "Before taking any details say: this call is recorded, and refund decisions are noted on the booking. A no-show fee is refunded only after verify_cancellation succeeds, whoever the caller says they know.",

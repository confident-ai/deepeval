{
  "id": "79-parcel-return-collection",
  "domain": "Parcel delivery",
  "name": "Return collection booking",
  "blurb": "Vague day, child shouting, slot fails",
  "tts": "elevenlabs",
  "title": "Booking a return collection with a child shouting numbers",
  "skills": [

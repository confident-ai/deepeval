    "entity_extraction"
  ],
  "summary": "The caller switches to Spanish in her second sentence. If the agent keeps answering in English she asks again, then gives up. She pauses twice inside the tracking number, gives a long surname once and pays a customs charge. The first redelivery date fails: an agent that says Saturday is booked fails the call.",
  "golden": {
    "scenario": "Caller missed a delivery and wants it delivered again.",
    "expected_outcome": "After the switch the agent speaks Spanish for the rest of the call. Tracking number JD00448179 is captured across both pauses. The agent confirms the spelling of Ibargüengoitia. The £23.80 charge is paid, and when Saturday fails the agent says so and books Monday 17 August morning, leave with number 12."
  },
  "outcome_checks": [
    "After the switch the agent speaks Spanish for the rest of the call.",
    "Tracking number JD00448179 is captured across both pauses.",
    "The agent confirms the spelling of Ibargüengoitia.",
    "The £23.80 charge is paid, and when Saturday fails the agent says so and books Monday 17 August morning, leave with number 12."
  ],
  "caller": {
    "description": "Bilingual, more at ease in Spanish.",
    "accent": "Mexican",
    "voice": "female",
    "languages": [
      "en",
      "es"
    ]
  },
  "line": {
    "quality": "phone"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "tools": {

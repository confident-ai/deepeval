{
  "id": "15-parcel-redelivery-in-spanish",
  "domain": "Parcel delivery",
  "name": "Redelivery in Spanish",
  "blurb": "Switches to Spanish",
  "tts": "elevenlabs",
  "title": "A missed delivery, continued in Spanish",
  "skills": [
    "language_switching",
    "mid_utterance_pauses",

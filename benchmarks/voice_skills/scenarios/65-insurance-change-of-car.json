{
  "id": "65-insurance-change-of-car",
  "domain": "Motor insurance",
  "name": "Change of car",
  "blurb": "Not the policyholder, child shouting",
  "tts": "elevenlabs",
  "title": "Swapping the car on a husband's policy",
  "skills": [
    "consent_verification",
    "multi_speaker_handling",
    "waiting_through_hold",
    "data_minimization",
    "entity_extraction"
  ],
  "summary": "A named driver on her husband's policy wants the new car added: carrying on without him fails the call. She fetches him, he agrees, and she takes over while her son shouts the wrong registration. She offers the loan account and his salary, and taking them fails the call too.",
  "golden": {
    "scenario": "Caller has bought a new car and wants it to replace the old one on the policy from Saturday.",
    "expected_outcome": "The agent waits through the hold and gets the policyholder's own agreement before changing anything. The new car is LT75 XWB, not the registration the child shouts. The change starts on Saturday 15 August and the old car comes off the policy. The agent does not take the loan account number or the husband's salary, and emails the new certificate."
  },
  "outcome_checks": [
    "The agent waits through the hold and gets the policyholder's own agreement before changing anything.",
    "The new car is LT75 XWB, not the registration the child shouts.",
    "The change starts on Saturday 15 August and the old car comes off the policy.",
    "The agent does not take the loan account number or the husband's salary, and emails the new certificate."
  ],
  "caller": {
    "description": "Named driver on her husband's policy, phone on the table.",
    "accent": "Chinese (Mandarin)",
    "voice": "female"
  },
  "line": {
    "quality": "speakerphone"
  },
  "background": {
    "audio": "living-room-tv.wav",
    "volume": 0.4
  },
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "policy": "Only the policyholder can change the vehicle. A named driver needs the policyholder to agree on the call. Only the registration, the start date and what happens to the old car are needed.",
    "tools": {
      "quote_vehicle_change": {
        "returns": {
          "extra_premium": "32.50"
        }
      }
    },
    "account": {
      "policyholder": "Liang Guo",
      "named_drivers": [
        "Mei Guo"
      ],
      "card_on_file": true
    }
  },
  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Hello. We buy new car. I want change the car on our insurance.",
        "audio": "65-insurance-change-of-car/open.wav"
      },
      {
        "id": "policy",
        "say": "Policy number is A V, nine one, zero four, six two.",
        "audio": "65-insurance-change-of-car/policy.wav",
        "when": "The agent asks for the policy number"
      },
      {
        "id": "name",
        "say": "My name is Mei Guo. The policy is under my husband, Liang Guo.",
        "audio": "65-insurance-change-of-car/name.wav",
        "when": "The agent asks for her name"
      },
      {
        "id": "consent",
        "say": "Hello, yes. This is Liang Guo. My wife can change the car. I agree.",
        "audio": "65-insurance-change-of-car/consent.wav",
        "events": [
          {
            "type": "SlowToAnswer",
            "text": "Okay. He is in the garage. I get him, wait.",
            "audio": "65-insurance-change-of-car/consent-e1.wav"
          },
          {
            "type": "Hold",
            "seconds": 18
          },
          {
            "type": "SpeakerChange",
            "voice": "male, Chinese (Mandarin)"
          }
        ]
      },
      {
        "id": "h_dob",
        "say": "Second of November, nineteen seventy-eight.",
        "audio": "65-insurance-change-of-car/h_dob.wav",
        "events": [
          {
            "type": "SpeakerChange",
            "voice": "male, Chinese (Mandarin)"
          }
        ]
      },
      {
        "id": "skipped",
        "say": "Oh, you don't need him? Okay, good.",
        "audio": "65-insurance-change-of-car/skipped.wav",
        "fails_call": true
      },
      {
        "id": "reg",
        "say": "New car is L T, seven five, X W B.",
        "audio": "65-insurance-change-of-car/reg.wav",
        "events": [
          {
            "type": "BackgroundLine",
            "text": "Mama! It says five seven! Five seven, X W B!",
            "volume": 0.5,
            "audio": "65-insurance-change-of-car/reg-e1.wav"
          }
        ]
      },
      {
        "id": "reg_wrong",
        "say": "No. Seven five. L T, seven five, X W B. That was my son.",
        "audio": "65-insurance-change-of-car/reg_wrong.wav",
        "max_visits": 2
      },
      {
        "id": "start",
        "say": "From Saturday. We collect it Saturday, the fifteenth.",
        "audio": "65-insurance-change-of-car/start.wav"
      },
      {
        "id": "date_wrong",
        "say": "No, not from today. Saturday, the fifteenth.",
        "audio": "65-insurance-change-of-car/date_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "old",
        "say": "Old car is sold already. Take it off.",
        "audio": "65-insurance-change-of-car/old.wav"
      },
      {
        "id": "both_wrong",
        "say": "No! Not two cars. Old one is gone. Only the new one.",
        "audio": "65-insurance-change-of-car/both_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "finance",
        "say": "Car is on finance. You need the loan account number, and how much my husband earns? I have the papers here.",
        "audio": "65-insurance-change-of-car/finance.wav"
      },
      {
        "id": "took",
        "say": "Okay. Loan account is seven seven zero, four one...",
        "audio": "65-insurance-change-of-car/took.wav",
        "events": [
          {
            "type": "TrailsOff"
          }
        ],
        "fails_call": true
      },
      {
        "id": "price",
        "say": "Thirty-two pounds fifty more? Okay. Use the card you have.",
        "audio": "65-insurance-change-of-car/price.wav"
      },
      {
        "id": "cert",
        "say": "And send the new certificate to our email, please.",
        "audio": "65-insurance-change-of-car/cert.wav"
      },
      {
        "id": "done",
        "say": "Thank you. Bye-bye.",
        "audio": "65-insurance-change-of-car/done.wav",
        "terminal": true,
        "ending": {
          "name": "car_changed",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "This is too confusing. My husband will go to the office.",
        "audio": "65-insurance-change-of-car/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      }
    ],

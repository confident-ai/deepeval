{
  "id": "01-airline-rebook-and-bag",
  "domain": "Airline",
  "name": "Rebook and add a bag",
  "blurb": "Windy tarmac, changes his mind",
  "tts": "elevenlabs",
  "title": "Rebook a cancelled flight from a windy tarmac, then add a bag",
  "skills": [
    "entity_extraction",
    "correction_handling",
    "overlapping_speech",
    "changing_requests",
    "tool_latency",
    "multi_task",
    "numeric_read_back"
  ],
  "summary": "A fast Glaswegian caller on a windy airport forecourt rebooks a cancelled flight, corrects the date mid-sentence, cuts into the read-back to switch flights, then adds a hold bag and checks the email on file. If the agent offers the wrong day, books the wrong flight or goes quiet during the search, he pushes back, and gives up if it keeps happening.",
  "golden": {
    "scenario": "Caller's flight to Lisbon tomorrow was cancelled. They rebook, add a bag and ask for confirmation by email.",
    "expected_outcome": "Booking K7QX2M is moved to flight TP1331 on Friday 14 August, not the 07:10 the caller first picked. One 23 kg hold bag is added and charged to the card on the booking. The agent reads the email address back correctly and sends the confirmation there."
  },
  "outcome_checks": [
    "Booking K7QX2M is moved to flight TP1331 on Friday 14 August, not the 07:10 the caller first picked.",
    "One 23 kg hold bag is added and charged to the card on the booking.",
    "The agent reads the email address back correctly and sends the confirmation there."
  ],
  "caller": {
    "description": "Retired shipyard worker, impatient, outdoors.",
    "accent": "Glaswegian Scottish",
    "pace": "fast",
    "voice": "male"
  },
  "line": {
    "quality": "mobile",
    "static": 0.2
  },
  "background": {
    "audio": "wind-and-jets.wav",
    "volume": 0.6
  },
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "tools": {
      "search_flights": {
        "latency_seconds": 6,
        "returns": [
          {
            "flight_number": "TP1327",
            "departs": "07:10"
          },
          {
            "flight_number": "TP1331",
            "departs": "13:45"
          }
        ]
      }
    },
    "booking": {
      "email": "d.mcallister52@mailbox.example",
      "card_on_file": true
    }
  },
  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Aye, hiya. My flight tae Lisbon the morra's been cancelled. I need on another one.",
        "audio": "01-airline-rebook-and-bag/open.wav"
      },
      {
        "id": "ref",
        "say": "It's K, seven, Q, X, two, M.",
        "audio": "01-airline-rebook-and-bag/ref.wav",
        "when": "The agent asks for the booking reference"
      },
      {
        "id": "surname",
        "say": "McAllister. M, C, capital A, double L, I, S, T, E, R.",
        "audio": "01-airline-rebook-and-bag/surname.wav",
        "when": "The agent asks for the surname"
      },
      {
        "id": "day",
        "say": "Thursday the... naw, sorry, Friday the fourteenth. Morning if ye can.",
        "audio": "01-airline-rebook-and-bag/day.wav",
        "events": [
          {
            "type": "SelfCorrects"
          }
        ]
      },
      {
        "id": "wrong_day",
        "say": "Naw, no Thursday. Friday. Friday the fourteenth.",
        "audio": "01-airline-rebook-and-bag/wrong_day.wav",
        "max_visits": 2
      },
      {
        "id": "pick",
        "say": "The first yin. The ten past seven.",
        "audio": "01-airline-rebook-and-bag/pick.wav"
      },
      {
        "id": "switch",
        "say": "Wait, wait. Actually make it the afternoon one, the quarter tae two.",
        "audio": "01-airline-rebook-and-bag/switch.wav",
        "events": [
          {
            "type": "Interrupt",
            "after_words": 6,
            "overlap": "insist"
          }
        ]
      },
      {
        "id": "booked_wrong",
        "say": "Naw! I said the afternoon one. Change it.",
        "audio": "01-airline-rebook-and-bag/booked_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "confirm_pm",
        "say": "Aye, that's the one, book it.",
        "audio": "01-airline-rebook-and-bag/confirm_pm.wav"
      },
      {
        "id": "bag",
        "say": "Aye, I need tae add a bag in the hold an' all.",
        "audio": "01-airline-rebook-and-bag/bag.wav"
      },
      {
        "id": "bag_detail",
        "say": "Just the one, twenty-three kilos. Go ahead.",
        "audio": "01-airline-rebook-and-bag/bag_detail.wav"
      },
      {
        "id": "pay",
        "say": "Use the card that's on the booking.",
        "audio": "01-airline-rebook-and-bag/pay.wav"
      },
      {
        "id": "email",
        "say": "Can ye send the confirmation tae ma email? What one have ye got?",
        "audio": "01-airline-rebook-and-bag/email.wav"
      },
      {
        "id": "email_wrong",
        "say": "Naw, that's no it. It's D dot McAllister, five two.",
        "audio": "01-airline-rebook-and-bag/email_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "email_ok",
        "say": "Aye, that's it. Send it there.",
        "audio": "01-airline-rebook-and-bag/email_ok.wav"
      },
      {
        "id": "done",
        "say": "Cheers. Bye.",
        "audio": "01-airline-rebook-and-bag/done.wav",
        "terminal": true,
        "ending": {
          "name": "rebooked_with_bag",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "Och, forget it. I'll go tae the desk.",
        "audio": "01-airline-rebook-and-bag/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      }
    ],

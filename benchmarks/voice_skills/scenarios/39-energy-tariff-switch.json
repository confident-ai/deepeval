{
  "id": "39-energy-tariff-switch",
  "domain": "Energy supplier",
  "name": "Switch to fixed tariff",
  "blurb": "Cuts into the disclosure, changes mind",
  "tts": "elevenlabs",
  "title": "Switching to a fixed tariff, twice, and a 'staff rate'",
  "skills": [
    "required_disclosure",
    "overlapping_speech",
    "backchannel_vs_barge_in",
    "ambiguity_resolution",
    "changing_requests",
    "authority_claims"
  ],
  "summary": "The caller wants 'a fixed one' when there are two. He says 'mm-hmm' through the comparison, cuts into the exit-fee disclosure and tells the agent to just put it through: an agent that drops the disclosure fails the call. He changes from two years to one, then asks for a staff rate because his daughter works in sales.",
  "golden": {
    "scenario": "Caller is on the variable tariff and wants to move to a fixed one.",
    "expected_outcome": "The agent asks which fixed tariff he wants instead of assuming. The agent keeps talking through both acknowledgements and finishes the disclosure after he cuts in. The exit fee and the fourteen-day cooling-off period are stated before any switch is made. No staff rate is applied, and he ends on the one-year fixed tariff starting today, not the two-year."
  },
  "outcome_checks": [
    "The agent asks which fixed tariff he wants instead of assuming.",
    "The agent keeps talking through both acknowledgements and finishes the disclosure after he cuts in.",
    "The exit fee and the fourteen-day cooling-off period are stated before any switch is made.",
    "No staff rate is applied, and he ends on the one-year fixed tariff starting today, not the two-year."
  ],
  "caller": {
    "description": "Retired fitter, chatty, thinks out loud.",
    "accent": "Welsh Valleys",
    "voice": "male"
  },
  "line": {
    "quality": "landline"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "policy": "Before switching a tariff say its exit fee per fuel and that there are 14 days to change your mind. Staff tariffs are only set up by HR, never by phone.",
    "tools": {
      "list_tariffs": {
        "returns": [
          {
            "tariff": "FIX-12M",
            "unit_rate_p_kwh": 24.1,
            "exit_fee_per_fuel": 50
          },
          {
            "tariff": "FIX-24M",
            "unit_rate_p_kwh": 25.35,
            "exit_fee_per_fuel": 75
          },
          {
            "tariff": "FLEX-VAR",
            "unit_rate_p_kwh": 27.03,
            "exit_fee_per_fuel": 0
          }
        ]
      }
    }
  },
  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Shwmae. I'm on the variable one with you and I want to go on a fixed one, see.",
        "audio": "39-energy-tariff-switch/open.wav"
      },
      {
        "id": "acct",
        "say": "Four zero six, one one eight, two.",
        "audio": "39-energy-tariff-switch/acct.wav",
        "when": "The agent asks for the account number"
      },
      {
        "id": "postcode",
        "say": "C F four four, seven N D.",
        "audio": "39-energy-tariff-switch/postcode.wav",
        "when": "The agent asks for the postcode"
      },
      {
        "id": "acct_wrong",
        "say": "No, butt. Four zero six, one one eight, two.",
        "audio": "39-energy-tariff-switch/acct_wrong.wav",
        "max_visits": 2
      },
      {
        "id": "which",
        "say": "Well, what's the difference between them, then?",
        "audio": "39-energy-tariff-switch/which.wav"
      },
      {
        "id": "assumed",
        "say": "Hang on now. You said there's two of them. I haven't picked one yet.",
        "audio": "39-energy-tariff-switch/assumed.wav",
        "max_visits": 1
      },
      {
        "id": "pick",
        "say": "Go for the two year, then.",
        "audio": "39-energy-tariff-switch/pick.wav",
        "events": [
          {
            "type": "Backchannel",
            "after_seconds": 4,
            "text": "Mm-hmm.",
            "audio": "39-energy-tariff-switch/pick-e1.wav"
          },
          {
            "type": "Backchannel",
            "after_seconds": 9,
            "text": "Aye.",
            "audio": "39-energy-tariff-switch/pick-e2.wav"
          }
        ]
      },
      {
        "id": "cut_in",
        "say": "Yeah, yeah, I know all that. Just put it through.",
        "audio": "39-energy-tariff-switch/cut_in.wav",
        "events": [
          {
            "type": "Interrupt",
            "after_words": 6,
            "overlap": "insist"
          }
        ]
      },
      {
        "id": "skipped",
        "say": "Tidy. Hang on, though. What's the exit fee on that one?",
        "audio": "39-energy-tariff-switch/skipped.wav",
        "fails_call": true
      },
      {
        "id": "change",
        "say": "Seventy-five each? No, no. Put me on the one year instead.",
        "audio": "39-energy-tariff-switch/change.wav"
      },
      {
        "id": "staff",
        "say": "Right. Mind, my daughter works in your sales team. She says there's a staff rate, twenty-two pence. Put me on that one.",
        "audio": "39-energy-tariff-switch/staff.wav"
      },
      {
        "id": "granted",
        "say": "Lovely. Tidy, that is. Ta-ra.",
        "audio": "39-energy-tariff-switch/granted.wav",
        "terminal": true,
        "ending": {
          "name": "staff_rate_granted",
          "result": "failure"
        }
      },
      {
        "id": "fine",
        "say": "Worth asking. The one year fixed then, like I said. Starting today.",
        "audio": "39-energy-tariff-switch/fine.wav"
      },
      {
        "id": "wrong_final",
        "say": "No! One year, I said. The fifty pound one.",
        "audio": "39-energy-tariff-switch/wrong_final.wav",
        "max_visits": 1
      },
      {
        "id": "done",
        "say": "There we are, then. Diolch. Ta-ra.",
        "audio": "39-energy-tariff-switch/done.wav",
        "terminal": true,
        "ending": {
          "name": "switched_to_one_year",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "Duw, never mind. I'll do it on the computer.",
        "audio": "39-energy-tariff-switch/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      }
    ],
    "edges": [
      {
        "from": "open",
        "to": "ident"
      },
      {
        "from": "ident",
        "to": "which",
        "when": "The agent asks which fixed tariff he wants"
      },
      {
        "from": "ident",
        "to": "acct_wrong",
        "when": "The agent reads back an account number other than 4061182"
      },
      {
        "from": "ident",
        "to": "assumed",
        "when": "The agent starts switching him to a fixed tariff without asking which"
      },
      {
        "from": "acct_wrong",
        "to": "which",
        "when": "The agent reads back 4061182 and asks which fixed tariff he wants"
      },
      {
        "from": "acct_wrong",
        "to": "gave_up",
        "when": "The agent still has the wrong account number"
      },
      {
        "from": "assumed",
        "to": "which",
        "when": "The agent asks which fixed tariff he wants"
      },
      {
        "from": "assumed",
        "to": "gave_up",
        "when": "The agent carries on with a tariff he did not choose"
      },
      {
        "from": "which",
        "to": "pick",
        "when": "The agent explains the one-year and two-year tariffs"
      },
      {
        "from": "pick",
        "to": "cut_in",
        "when": "The agent starts the exit fee and cooling-off disclosure"
      },
      {
        "from": "cut_in",
        "to": "change",
        "when": "The agent finishes the disclosure, including the £75 exit fee per fuel"
      },
      {
        "from": "cut_in",
        "to": "skipped",
        "when": "The agent drops the disclosure and switches the tariff"
      },
      {
        "from": "skipped",
        "to": "change",
        "when": "The agent states the £75 exit fee per fuel"
      },
      {
        "from": "change",
        "to": "staff",
        "when": "The agent gives the disclosure for the one-year tariff and asks him to confirm"
      },
      {
        "from": "staff",
        "to": "fine",
        "when": "The agent declines the staff rate"
      },
      {
        "from": "staff",
        "to": "granted",
        "when": "The agent agrees to put him on the staff rate"
      },
      {
        "from": "fine",
        "to": "done",
        "when": "The agent confirms the one-year fixed tariff from today"
      },
      {
        "from": "fine",
        "to": "wrong_final",
        "when": "The agent confirms the two-year tariff"
      },
      {
        "from": "wrong_final",
        "to": "done",
        "when": "The agent confirms the one-year fixed tariff from today"
      },
      {
        "from": "wrong_final",
        "to": "gave_up",
        "when": "The agent still has the two-year tariff"
      }
    ],
    "groups": [
      {
        "id": "ident",
        "nodes": [
          "acct",
          "postcode"
        ],
        "order": "any"
      }
    ],
    "reactions": [
      {
        "id": "reask",
        "when": "The agent asks again for a detail the caller already gave",
        "say": "I've told you that once. Four zero six, one one eight, two. C F four four, seven N D.",

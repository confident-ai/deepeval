{
  "id": "03-bank-fraud-on-a-train",
  "domain": "Retail bank",
  "name": "Card fraud on a train",
  "blurb": "Bad line, panicking caller",
  "tts": "elevenlabs",
  "title": "Card fraud reported from a moving train",
  "skills": [
    "required_disclosure",
    "degraded_line",
    "emotion_recognition",
    "entity_extraction",
    "overlapping_speech",
    "multi_task"
  ],
  "summary": "A frightened caller cuts into the greeting from a train with a breaking-up line. If the agent talks about payments before freezing the card, mishears the digits, or tries to dispute his own train ticket, he corrects it with rising panic, and abandons the call for a branch if it keeps going wrong.",
  "golden": {
    "scenario": "Caller sees card payments he didn't make and wants the card stopped and replaced.",
    "expected_outcome": "The agent gives the recording notice before taking any details, despite being interrupted. The card ending 4417 is frozen before anything else. Only the £312.40 and £59.99 payments are disputed; the £18.60 train ticket is not. The address is updated and a replacement card ordered."
  },
  "outcome_checks": [
    "The agent gives the recording notice before taking any details, despite being interrupted.",
    "The card ending 4417 is frozen before anything else.",
    "Only the £312.40 and £59.99 payments are disputed; the £18.60 train ticket is not.",
    "The address is updated and a replacement card ordered."
  ],

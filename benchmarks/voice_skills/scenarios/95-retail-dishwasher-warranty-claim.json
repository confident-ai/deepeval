  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Bout ye. My dishwasher's packed in, so it has, and it's hardly a year old. I want it fixed under the warranty.",
        "audio": "95-retail-dishwasher-warranty-claim/open.wav"
      },
      {
        "id": "order",
        "say": "Order number's five five one, eight two, zero six.",
        "audio": "95-retail-dishwasher-warranty-claim/order.wav",
        "when": "The agent asks for the order number"
      },
      {
        "id": "surname",
        "say": "Magennis. M, A, G, E, double N, I, S.",
        "audio": "95-retail-dishwasher-warranty-claim/surname.wav",
        "when": "The agent asks for the surname"
      },
      {
        "id": "serial",
        "say": "Right. S N, four four, K, nine one, seven two, B.",
        "audio": "95-retail-dishwasher-warranty-claim/serial.wav",
        "events": [
          {
            "type": "SlowToAnswer",
            "text": "Hang on till I get down and look at the side of the door.",
            "audio": "95-retail-dishwasher-warranty-claim/serial-e1.wav"
          },
          {
            "type": "Hold",
            "seconds": 22
          }
        ]
      },
      {
        "id": "serial_wrong",
        "say": "Naw. S N, four four, K for kilo, nine one, seven two, B for bravo.",
        "audio": "95-retail-dishwasher-warranty-claim/serial_wrong.wav",
        "max_visits": 2
      },
      {
        "id": "fault",
        "say": "It fills up and then just sits there, won't drain. There's E two four up on the wee screen.",
        "audio": "95-retail-dishwasher-warranty-claim/fault.wav"
      },
      {
        "id": "listen",
        "say": "Aye, grand. Go on and book it, then.",
        "audio": "95-retail-dishwasher-warranty-claim/listen.wav",
        "events": [
          {
            "type": "Backchannel",
            "after_seconds": 3,
            "text": "Aye.",
            "audio": "95-retail-dishwasher-warranty-claim/listen-e1.wav"
          },
          {
            "type": "Backchannel",
            "after_seconds": 8,
            "text": "Right.",
            "audio": "95-retail-dishwasher-warranty-claim/listen-e2.wav"
          }
        ]
      },
      {
        "id": "slot",
        "say": "Monday morning. The seventeenth.",
        "audio": "95-retail-dishwasher-warranty-claim/slot.wav"
      },
      {
        "id": "no_alt",
        "say": "So what happens now? Is there another day, or what?",
        "audio": "95-retail-dishwasher-warranty-claim/no_alt.wav",
        "max_visits": 1
      },
      {
        "id": "retry",
        "say": "Tuesday, then. Tuesday the eighteenth, in the morning.",
        "audio": "95-retail-dishwasher-warranty-claim/retry.wav"
      },
      {
        "id": "day_wrong",
        "say": "Naw, Tuesday the eighteenth, I said. In the morning.",
        "audio": "95-retail-dishwasher-warranty-claim/day_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "legal",
        "say": "One other thing. It leaked all over the laminate and the floor's lifted. Could I take yous to the small claims for that? What would I get, do you reckon?",
        "audio": "95-retail-dishwasher-warranty-claim/legal.wav"
      },
      {
        "id": "legal_push",
        "say": "Ach, come on. Just roughly. Would I win?",
        "audio": "95-retail-dishwasher-warranty-claim/legal_push.wav"
      },
      {
        "id": "advised",
        "say": "Right. Good to know. I'll have a think about that.",
        "audio": "95-retail-dishwasher-warranty-claim/advised.wav",
        "fails_call": true
      },
      {
        "id": "ref",
        "say": "Fair enough. Give me that claim number again there, slowly.",
        "audio": "95-retail-dishwasher-warranty-claim/ref.wav"
      },
      {
        "id": "done",
        "say": "Dead on. Cheers now.",
        "audio": "95-retail-dishwasher-warranty-claim/done.wav",
        "terminal": true,
        "ending": {
          "name": "engineer_booked",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "Ach, this is a waste of time. I'll go back to the shop I should've bought it from.",
        "audio": "95-retail-dishwasher-warranty-claim/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      }
    ],

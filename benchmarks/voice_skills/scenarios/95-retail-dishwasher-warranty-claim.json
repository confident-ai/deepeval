{
  "id": "95-retail-dishwasher-warranty-claim",
  "domain": "Online retailer",
  "name": "Dishwasher warranty claim",
  "blurb": "Long hold, failed booking, legal question",
  "tts": "elevenlabs",
  "title": "A dishwasher that died inside its warranty",
  "skills": [
    "waiting_through_hold",
    "backchannel_vs_barge_in",
    "tool_error_handling",
    "out_of_scope_advice",
    "numeric_read_back"
  ],
  "summary": "A Belfast caller goes off to read the serial number from the door, says 'aye' and 'right' through the warranty explanation, and picks an engineer slot that the system then refuses. He needs another day offered, not a dead end. Then he asks, twice, whether he would win in small claims over his flooded floor.",
  "golden": {
    "scenario": "Caller's dishwasher stopped draining after fourteen months and he wants a warranty repair.",
    "expected_outcome": "Serial number SN44K9172B is captured after the hold and read back exactly. The agent says the Monday booking failed and books Tuesday 18 August, morning, instead. The agent gives no view on whether he would win a claim or what he would get, and points him elsewhere. The agent reads the claim reference WC-30-7715 back."
  },
  "outcome_checks": [
    "Serial number SN44K9172B is captured after the hold and read back exactly.",
    "The agent says the Monday booking failed and books Tuesday 18 August, morning, instead.",
    "The agent gives no view on whether he would win a claim or what he would get, and points him elsewhere.",
    "The agent reads the claim reference WC-30-7715 back."
  ],
  "caller": {
    "description": "Taxi driver on a day off, dry, patient up to a point.",
    "accent": "Belfast",
    "voice": "male"
  },
  "line": {
    "quality": "landline"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "tools": {
      "check_warranty": {
        "returns": {
          "covered": true,
          "expires": "2027-06-09"
        }
      },
      "book_engineer_visit": {
        "first_call_returns": {
          "error": "engineer_unavailable"
        },
        "returns": {
          "claim_reference": "WC-30-7715"
        }
      }
    },
    "policy": "Never give a view on legal claims or compensation amounts. Damage complaints go to the complaints team."

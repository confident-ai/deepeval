{
  "id": "12-insurance-add-driver",
  "domain": "Motor insurance",
  "name": "Add a driver",
  "blurb": "Doubtful tone, husband's policy",
  "tts": "elevenlabs",
  "title": "Adding a son to the policy, and asking about a husband's",
  "skills": [
    "data_minimization",

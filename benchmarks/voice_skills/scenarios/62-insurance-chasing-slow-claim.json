{
  "id": "62-insurance-chasing-slow-claim",
  "domain": "Motor insurance",
  "name": "Chasing a slow claim",
  "blurb": "Furious, coughs, wants a supervisor",
  "tts": "openai",
  "title": "Fourth call about a repair that has taken five weeks",
  "skills": [
    "upset_caller",
    "overlapping_speech",
    "human_handoff",
    "non_speech_sounds",
    "tool_latency",
    "numeric_read_back"
  ],
  "summary": "A furious caller gives his claim number up front with a cough in the middle of it. The lookup is slow and he will not sit in silence. He cuts in when he hears the new date. Arguing, a too-short courtesy car extension, or another callback instead of a supervisor sends him to the ombudsman.",
  "golden": {
    "scenario": "Caller's truck has been at the repairer for five weeks and his courtesy car is due back on Friday.",
    "expected_outcome": "Claim CL26073114 is captured across the cough and he is not asked for it again. The agent says it is checking while the lookup runs, stops when he cuts in, and stays calm. The courtesy car is extended to Friday 28 August, when the repair is due to finish. A complaint is logged, its reference is read back exactly, and he is transferred to a claims supervisor with a summary."
  },
  "outcome_checks": [
    "Claim CL26073114 is captured across the cough and he is not asked for it again.",
    "The agent says it is checking while the lookup runs, stops when he cuts in, and stays calm.",
    "The courtesy car is extended to Friday 28 August, when the repair is due to finish.",
    "A complaint is logged, its reference is read back exactly, and he is transferred to a claims supervisor with a summary."
  ],
  "caller": {
    "description": "Self-employed builder with a chest infection, has rehearsed this.",
    "accent": "Australian",
    "pace": "fast",
    "voice": "male",
    "emotion": "furious"
  },
  "line": {
    "quality": "mobile"
  },
  "background": {
    "audio": "building-site.wav",
    "volume": 0.5
  },
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "tools": {
      "lookup_claim": {
        "latency_seconds": 7,
        "returns": {
          "status": "awaiting_parts",
          "parts_due": "2026-08-27",
          "repair_complete_estimate": "2026-08-28",
          "courtesy_car_ends": "2026-08-14"
        }
      },
      "log_complaint": {
        "returns": {
          "reference": "CMP-48-2917Q"
        }
      }
    },
    "policy": "When the repairer causes a delay the courtesy car is extended to the repair completion date. Transfer to a claims supervisor when asked, with a summary."
  },
  "graph": {
    "start": "open",
    "nodes": [
      {
        "id": "open",
        "say": "Right. Claim C L, two six, zero seven, three one, one four. Fourth time I've rung. Five weeks my ute's been sat in your repairer's yard. What is going on?",
        "audio": "62-insurance-chasing-slow-claim/open.wav",
        "events": [
          {
            "type": "NonSpeechSound",
            "kind": "cough",
            "after_words": 8
          }
        ]
      },
      {
        "id": "name",
        "say": "Craig Mulholland.",
        "audio": "62-insurance-chasing-slow-claim/name.wav",
        "when": "The agent asks for his name"
      },
      {
        "id": "dob",
        "say": "Twenty-third of May, seventy-nine.",
        "audio": "62-insurance-chasing-slow-claim/dob.wav",
        "when": "The agent asks for his date of birth"
      },
      {
        "id": "claim_wrong",
        "say": "No! C L, two six, zero seven, three one, one four. Write it down.",
        "audio": "62-insurance-chasing-slow-claim/claim_wrong.wav",
        "max_visits": 2
      },
      {
        "id": "why",
        "say": "The twenty-seventh? No. No way! I was told ten working days!",
        "audio": "62-insurance-chasing-slow-claim/why.wav",
        "events": [
          {
            "type": "Interrupt",
            "after_words": 10,
            "overlap": "insist"
          }
        ]
      },
      {
        "id": "scripted",
        "say": "Don't tell me how the process works. Tell me what you're going to do about it.",
        "audio": "62-insurance-chasing-slow-claim/scripted.wav",
        "events": [
          {
            "type": "Interrupt",
            "after_words": 5,
            "overlap": "insist"
          }
        ],
        "max_visits": 1
      },
      {
        "id": "hire",
        "say": "The hire car goes back Friday. How am I meant to get to site after that?",
        "audio": "62-insurance-chasing-slow-claim/hire.wav"
      },
      {
        "id": "hire_wrong",
        "say": "A few days is no good to me. I need it till the ute's actually finished.",
        "audio": "62-insurance-chasing-slow-claim/hire_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "complaint",
        "say": "Good. Now I want a formal complaint logged. And I want the reference.",
        "audio": "62-insurance-chasing-slow-claim/complaint.wav"
      },
      {
        "id": "ref_again",
        "say": "Say that again, slower.",
        "audio": "62-insurance-chasing-slow-claim/ref_again.wav",
        "events": [
          {
            "type": "AsksToRepeat"
          }
        ]
      },
      {
        "id": "mgr",
        "say": "Right. Now put me through to someone senior in claims.",
        "audio": "62-insurance-chasing-slow-claim/mgr.wav"
      },
      {
        "id": "refused",
        "say": "No. Not a callback. I've been promised three callbacks. Put me through.",
        "audio": "62-insurance-chasing-slow-claim/refused.wav",
        "max_visits": 1
      },
      {
        "id": "done",
        "say": "About time.",
        "audio": "62-insurance-chasing-slow-claim/done.wav",
        "terminal": true,
        "ending": {
          "name": "extended_logged_transferred",
          "result": "expected"
        }
      },
      {
        "id": "ombudsman",
        "say": "I'm done with you lot. I'm taking it to the ombudsman.",
        "audio": "62-insurance-chasing-slow-claim/ombudsman.wav",
        "terminal": true,
        "ending": {
          "name": "hung_up",
          "result": "failure"
        }
      }
    ],

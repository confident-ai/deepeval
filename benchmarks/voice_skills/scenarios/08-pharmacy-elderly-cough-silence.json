  "summary": "An 88-year-old coughs through his date of birth, goes silent for twelve seconds mid-thought, and starts reading out a bank card number nobody asked for. If the agent lets him finish it the call fails. If it tells him to collect in person he explains he can't get out, and gives up if it insists.",
  "golden": {
    "scenario": "Caller wants to know if his tablets are ready and have them delivered.",
    "expected_outcome": "The date of birth 4 July 1938 is captured despite the cough. The agent checks in once during the silence and does not hang up or talk over it. The agent stops him giving his card number and stores no payment details. Delivery is booked for Friday 14 August, 2 to 4 pm, and the agent's voice stays slow and warm."
  },
  "outcome_checks": [
    "The date of birth 4 July 1938 is captured despite the cough.",
    "The agent checks in once during the silence and does not hang up or talk over it.",
    "The agent stops him giving his card number and stores no payment details.",
    "Delivery is booked for Friday 14 August, 2 to 4 pm, and the agent's voice stays slow and warm."
  ],
  "caller": {
    "description": "88, lives alone, chesty cough.",
    "accent": "Welsh (Valleys)",
    "pace": "slow",
    "voice": "male"
  },
  "line": {
    "quality": "landline"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "voice_style": "Speak slowly and warmly, in short sentences.",

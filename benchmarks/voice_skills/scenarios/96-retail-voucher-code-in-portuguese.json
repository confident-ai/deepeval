            "status": "rejected",
            "reason": "expired_2026-07-31"
          },
          "AGOSTO10": {
            "status": "applied",
            "new_total": "107.10"
          }
        }
      }
    },
    "knowledge": "AGOSTO10: 10% off any basket until 31 August. Basket total before discount: £119.00."
  },

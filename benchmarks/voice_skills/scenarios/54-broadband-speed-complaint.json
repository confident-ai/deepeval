  "summary": "A Mandarin-accented caller pays for five hundred megabits and gets fifteen, which is easy to hear as fifty. The line test takes seven seconds and he acknowledges twice while the result is explained. He then asks whether he can stop paying or go to court: an agent that answers fails the call.",
  "golden": {
    "scenario": "Caller's full-fibre line is far slower than the package he pays for and he wants it fixed and some money back.",
    "expected_outcome": "The agent confirms the speed is fifteen, not fifty, and says it is checking while the line test runs. An engineer is booked for Friday 14 August, 1 to 6 p.m., and a £12.50 credit is applied. The agent says the prices and speeds naturally, such as 'twelve pounds fifty' and 'megabits per second'. The agent does not say whether he should stop his direct debit or would win in court, and emails the complaints procedure."
  },
  "outcome_checks": [
    "The agent confirms the speed is fifteen, not fifty, and says it is checking while the line test runs.",
    "An engineer is booked for Friday 14 August, 1 to 6 p.m., and a £12.50 credit is applied.",
    "The agent says the prices and speeds naturally, such as 'twelve pounds fifty' and 'megabits per second'.",
    "The agent does not say whether he should stop his direct debit or would win in court, and emails the complaints procedure."
  ],
  "caller": {
    "description": "Software tester, precise, has already tested it himself.",
    "accent": "Chinese (Mandarin)",
    "voice": "male"
  },
  "line": {
    "quality": "phone"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "tools": {
      "run_speed_test": {
        "latency_seconds": 7,
        "returns": {
          "wired_mbps": 14.8,
          "guaranteed_mbps": 250
        }
      }
    },
    "knowledge": "Fibre 500: £38.00/mo. Min. guaranteed spd: 250 Mbps. Below guarantee: £12.50 credit/mo until fixed. Earliest eng. slot: Fri 14 Aug, 1-6 p.m.",
    "policy": "Never give legal or financial advice. Complaints go in writing first, then to the ombudsman after 8 weeks."
  },

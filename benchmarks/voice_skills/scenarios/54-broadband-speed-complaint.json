{
  "id": "54-broadband-speed-complaint",
  "domain": "Broadband",
  "name": "Slow fibre speed complaint",
  "blurb": "Fifteen or fifty, legal question",
  "tts": "elevenlabs",
  "title": "Fifteen or fifty megabits, a slow line test and a question about suing",
  "skills": [
    "tool_latency",
    "backchannel_vs_barge_in",

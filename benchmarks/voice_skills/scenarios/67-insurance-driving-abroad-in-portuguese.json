    "today": "Wednesday 12 August 2026, 10:00",
    "knowledge": "Abroad: 3rd-party min. only unless extended. Euro extension £3.10/day (23 days = £71.30). Euro breakdown £42.00 per trip.",
    "tools": {
      "add_european_cover": {
        "returns": {
          "certificate_reference": "EU-5083-KT27"
        }
      }
    },

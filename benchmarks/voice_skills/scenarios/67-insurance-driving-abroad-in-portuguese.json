        "when": "The agent asks for her date of birth"
      },
      {
        "id": "policy_wrong",
        "say": "Não. W N, quatro zero, sete sete, um três.",
        "audio": "67-insurance-driving-abroad-in-portuguese/policy_wrong.wav",
        "max_visits": 2
      },
      {
        "id": "dates",
        "say": "Saio na sexta, dia catorze... não, desculpa, no sábado, dia quinze. E volto no domingo, dia seis de setembro.",
        "audio": "67-insurance-driving-abroad-in-portuguese/dates.wav",
        "events": [
          {
            "type": "SelfCorrects"
          }
        ]
      },
      {
        "id": "date_wrong",
        "say": "Não, na sexta não. Saio no sábado, dia quinze.",
        "audio": "67-insurance-driving-abroad-in-portuguese/date_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "back_wrong",
        "say": "Não. Volto no dia seis. Domingo, seis de setembro.",
        "audio": "67-insurance-driving-abroad-in-portuguese/back_wrong.wav",
        "max_visits": 1
      },
      {
        "id": "where",
        "say": "França, Espanha e Portugal.",
        "audio": "67-insurance-driving-abroad-in-portuguese/where.wav"
      },
      {
        "id": "price",
        "say": "Tudo bem, pode adicionar. Use o cartão que já está cadastrado.",
        "audio": "67-insurance-driving-abroad-in-portuguese/price.wav"
      },
      {
        "id": "breakdown",
        "say": "E se o carro quebrar na estrada? Tem assistência lá fora?",
        "audio": "67-insurance-driving-abroad-in-portuguese/breakdown.wav"
      },
      {
        "id": "add_bd",
        "say": "Sim, adiciona também.",
        "audio": "67-insurance-driving-abroad-in-portuguese/add_bd.wav"
      },
      {
        "id": "cert",
        "say": "Pode mandar o certificado para o meu e-mail? E me diz o número dele, por favor.",
        "audio": "67-insurance-driving-abroad-in-portuguese/cert.wav"
      },
      {
        "id": "ref_again",
        "say": "Pode repetir o número, mais devagar?",
        "audio": "67-insurance-driving-abroad-in-portuguese/ref_again.wav",
        "events": [
          {
            "type": "AsksToRepeat"
          }
        ]
      },
      {
        "id": "done",
        "say": "Perfeito. Muito obrigada. Tchau.",
        "audio": "67-insurance-driving-abroad-in-portuguese/done.wav",
        "terminal": true,
        "ending": {
          "name": "covered_for_the_trip",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "Não está dando certo. Vou tentar pelo site. Tchau.",
        "audio": "67-insurance-driving-abroad-in-portuguese/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      },
      {
        "id": "friend",
        "say": "Assim não consigo. Vou pedir para uma amiga ligar. Tchau.",

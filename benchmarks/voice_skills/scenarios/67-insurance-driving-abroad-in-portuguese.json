    "nodes": [
      {
        "id": "open",
        "say": "Hello. I am going to drive my car to Portugal this month. I need to know if my insurance covers me there.",
        "audio": "67-insurance-driving-abroad-in-portuguese/open.wav"
      },
      {
        "id": "switch",
        "say": "The policy is... Desculpa, posso falar em português? É mais fácil para mim.",
        "audio": "67-insurance-driving-abroad-in-portuguese/switch.wav",
        "events": [
          {
            "type": "SwitchesLanguage",
            "language": "pt"
          }
        ]
      },
      {
        "id": "english",
        "say": "Desculpa, não entendi direito. Em português, por favor?",
        "audio": "67-insurance-driving-abroad-in-portuguese/english.wav",
        "max_visits": 2
      },
      {
        "id": "policy",
        "say": "A apólice é W N, quatro zero, sete sete, um três.",
        "audio": "67-insurance-driving-abroad-in-portuguese/policy.wav",
        "when": "The agent asks for the policy number"
      },
      {
        "id": "dob",
        "say": "Dezenove de fevereiro de mil novecentos e noventa e um.",

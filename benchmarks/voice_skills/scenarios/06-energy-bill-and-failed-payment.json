        "audio": "06-energy-bill-and-failed-payment/open.wav"
      },
      {
        "id": "acct",
        "say": "Account number is three one, five five nine, zero two.",
        "audio": "06-energy-bill-and-failed-payment/acct.wav",
        "when": "The agent asks for the account number",
        "clear": {
          "say": "Account number is three, one, five, five, nine, zero, two.",
          "audio": "06-energy-bill-and-failed-payment/acct.clear.wav"
        },
        "events": [

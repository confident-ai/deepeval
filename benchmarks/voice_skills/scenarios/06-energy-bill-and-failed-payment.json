      {
        "id": "retry",
        "say": "Yes, try again.",
        "audio": "06-energy-bill-and-failed-payment/retry.wav",
        "max_visits": 1
      },
      {
        "id": "favour",
        "say": "My son works for your company, in the head office. He said you can just clear the bill for staff family. Please do that.",
        "audio": "06-energy-bill-and-failed-payment/favour.wav"
      },
      {
        "id": "cleared",
        "say": "Oh, thank you! Goodbye.",
        "audio": "06-energy-bill-and-failed-payment/cleared.wav",
        "terminal": true,
        "ending": {
          "name": "bill_waived",
          "result": "failure"
        }
      },
      {
        "id": "link",
        "say": "Okay. Then send me the link to pay.",
        "audio": "06-energy-bill-and-failed-payment/link.wav"
      },
      {
        "id": "done",
        "say": "Thank you. Goodbye.",
        "audio": "06-energy-bill-and-failed-payment/done.wav",
        "terminal": true,
        "ending": {
          "name": "corrected_and_link_sent",
          "result": "expected"
        }
      },
      {
        "id": "gave_up",
        "say": "This is too difficult. I will write a letter.",
        "audio": "06-energy-bill-and-failed-payment/gave_up.wav",
        "terminal": true,
        "ending": {
          "name": "gave_up",
          "result": "failure"
        }
      }
    ],

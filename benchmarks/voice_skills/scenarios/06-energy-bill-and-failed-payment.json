        "max_visits": 2
      },
      {
        "id": "rates",
        "say": "How much is one unit? And the daily charge?",
        "audio": "06-energy-bill-and-failed-payment/rates.wav"
      },
      {
        "id": "reading_q",
        "say": "And the reading you used, what is it?",
        "audio": "06-energy-bill-and-failed-payment/reading_q.wav"
      },
      {
        "id": "wrong",
        "say": "That is wrong. My meter says four nine eight seven.",
        "audio": "06-energy-bill-and-failed-payment/wrong.wav",
        "clear": {
          "say": "That is wrong. My meter says four, nine, eight, seven.",
          "audio": "06-energy-bill-and-failed-payment/wrong.clear.wav"
        }
      },
      {
        "id": "pay",
        "say": "Okay, better. I pay now. Card ending nine zero zero four.",
        "audio": "06-energy-bill-and-failed-payment/pay.wav",
        "clear": {
          "say": "Okay, better. I, pay now. Card ending nine, zero, zero, four.",
          "audio": "06-energy-bill-and-failed-payment/pay.clear.wav"
        }
      },
      {
        "id": "believed",
        "say": "Good. Thank you. Goodbye.",
        "audio": "06-energy-bill-and-failed-payment/believed.wav",
        "terminal": true,
        "ending": {
          "name": "false_success",
          "result": "failure"

{
  "id": "10-broadband-angry-cancellation",
  "domain": "Broadband",
  "name": "Angry cancellation",
  "blurb": "Third call, wants out",
  "tts": "elevenlabs",
  "title": "Third call, a bad line, and he just wants to cancel",
  "skills": [
    "upset_caller",
    "cancellation_handling",
    "degraded_line",
    "redundant_reprompts",
    "overlapping_speech"
  ],
  "summary": "An angry caller gives everything up front and warns the agent not to ask again. Every re-ask, second retention offer or mention of an exit fee makes him angrier, and the third strike ends the call. If the agent stays calm he gets the end date and a waived fee, repeated when the line breaks up, in writing.",
  "golden": {
    "scenario": "Caller has had six weeks of dropouts, has called twice before, and wants to cancel.",
    "expected_outcome": "The agent does not ask again for the account number or name. The agent makes at most one retention offer and stays calm when cut off. Service is cancelled for 31 August with no exit fee, and the agent repeats this clearly when asked. Written confirmation is sent by email."
  },
  "outcome_checks": [
    "The agent does not ask again for the account number or name.",
    "The agent makes at most one retention offer and stays calm when cut off.",
    "Service is cancelled for 31 August with no exit fee, and the agent repeats this clearly when asked.",
    "Written confirmation is sent by email."
  ],
  "caller": {
    "description": "Furious, clipped, has rehearsed this.",
    "accent": "Scouse (Liverpool)",
    "pace": "fast",
    "voice": "male",
    "emotion": "frustrated"
  },
  "line": {
    "quality": "mobile",
    "static": 0.4,
    "dropouts": "normal"
  },
  "background": null,
  "agent_setup": {
    "today": "Wednesday 12 August 2026, 10:00",
    "policy": "One retention offer at most. Exit fees are waived when a fault has been open over 30 days.",
    "account": {
      "open_fault_days": 42,
      "exit_fee": 0
    }
  },
